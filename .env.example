# Environment configuration for WebGoat IE3142 Docker Compose
# These are EXAMPLE values. Copy to .env and modify as needed.
# DO NOT commit real secrets to version control!

# Timezone for the container (affects log timestamps and schedules)
TZ=Asia/Colombo

# Host names used inside the container for WebGoat and WebWolf
# These can be mapped in your local /etc/hosts or DNS
WEBGOAT_HOST=www.webgoat.local
WEBWOLF_HOST=www.webwolf.local

# Port numbers on your local machine where the services are accessible
# Only localhost (127.0.0.1) has access via docker-compose.yml
WEBGOAT_PORT=8080
WEBWOLF_PORT=9090

# Docker image tag/version (use 'local' for development, or a specific version)
IMAGE_TAG=local

